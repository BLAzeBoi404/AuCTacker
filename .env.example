# Скопируй этот файл в .env и впиши свои значения.
# В git этот файл пушить МОЖНО, а вот .env — НИКОГДА (там секреты).

# База: локально или Neon (вставь строку из Neon → Connect → pooled)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# EXBO API (обязательно)
EXBO_CLIENT_ID=впиши-свой-client-id
EXBO_CLIENT_SECRET=впиши-свой-секрет

# Telegram-бот (необязательно — удобнее вставить в Настройках сайта)
# TELEGRAM_BOT_TOKEN=

# При необходимости можно переопределить адрес API
# EXBO_API_BASE_URL=https://eapi.stalzone.com

# Только для локальной проверки без фоновых запросов и Telegram
# AUCTRACKER_BACKGROUND=0

# Пароль администратора (без него вход в админку закрыт)
# ADMIN_PASSWORD=
